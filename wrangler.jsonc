{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fonscape-blog",
  "main": "worker/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/audio", "/audio/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 3 * * 0"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fonscape-community",
      "migrations_dir": "migrations"
    }
  ]
}

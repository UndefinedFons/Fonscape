# Use a unique value for each deployment. Do not commit a populated .env file.
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-token
# Required on both platforms. Generate a different value for every deployment;
# the server deliberately refuses rate-limited mutations when it is missing.
RATE_LIMIT_SALT=replace-with-a-long-random-secret

# Vercel + Turso runtime database. The Turso Marketplace integration supplies
# these names automatically; keep both server-side only.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-token

{
  "name": "fonscape",
  "version": "0.1.0",
  "description": "Fonscape（风栖），一款清新、响应式、注重阅读体验的 React 个人博客主题模板。",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UndefinedFons/Fonscape.git"
  },
  "homepage": "https://fonstage.space/",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Stores runtime accounts, comments, sessions and rate-limit state; published blog content remains in Git."
      },
      "ADMIN_USERNAME": {
        "description": "The one account name allowed to complete the one-time administrator bootstrap."
      },
      "ADMIN_BOOTSTRAP_TOKEN": {
        "description": "Generate a long random one-time token and remove it after the administrator account is created."
      },
      "RATE_LIMIT_SALT": {
        "description": "Generate a unique long random secret for hashing rate-limit subjects."
      }
    }
  },
  "scripts": {
    "generate:content-targets": "node scripts/generate-content-targets.mjs",
    "check:content-targets": "node scripts/generate-content-targets.mjs --check",
    "predev": "node scripts/generate-content-targets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-content-targets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "db:migrate:cloudflare": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm db:migrate:cloudflare && wrangler deploy",
    "migrate:turso": "node scripts/migrate-turso.mjs",
    "check": "node scripts/generate-content-targets.mjs --check && node --test && vite build"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@vercel/functions": "3.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "wrangler": "4.124.0"
  }
}

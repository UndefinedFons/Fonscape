{
  "name": "fonscape",
  "version": "2.1.1",
  "description": "Fonscape（风栖），一款清新、响应式、注重阅读体验的 React 个人博客主题模板。",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UndefinedFons/Fonscape.git"
  },
  "homepage": "https://github.com/UndefinedFons/Fonscape#readme",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "bin": {
    "fonscape": "scripts/fonscape-update.ts"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Stores runtime accounts, comments, sessions and rate-limit state; published blog content remains in Git."
      },
      "ADMIN_BOOTSTRAP_TOKEN": {
        "description": "Enter a long random one-time token. Leave no default value; the first administrator enters it on /admin/setup."
      }
    }
  },
  "scripts": {
    "generate:content-targets": "node scripts/generate-content-targets.ts",
    "generate:font-css": "node scripts/generate-font-css.ts",
    "generate:rss": "node scripts/generate-rss.ts",
    "generate:sitemap": "node scripts/generate-sitemap.ts",
    "generate:responsive-images": "node scripts/generate-responsive-images.ts",
    "generate": "node scripts/generate-responsive-images.ts && node scripts/generate-content-targets.ts && node scripts/generate-font-css.ts && node scripts/generate-rss.ts && node scripts/generate-sitemap.ts",
    "check:content-targets": "node scripts/generate-content-targets.ts --check",
    "check:font-css": "node scripts/generate-font-css.ts --check",
    "check:responsive-images": "node scripts/generate-responsive-images.ts --check",
    "check:performance-budget": "node scripts/check-performance-budget.ts",
    "dev": "pnpm generate && vite",
    "build": "pnpm generate && vite build",
    "build:vercel": "pnpm build && pnpm migrate:turso --apply",
    "preview": "vite preview",
    "test:offline": "node --test",
    "test": "pnpm generate && pnpm test:offline",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.backend.json && tsc -p tsconfig.scripts.json",
    "db:migrate:cloudflare": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm db:migrate:cloudflare && wrangler deploy",
    "migrate:turso": "node scripts/migrate-turso.ts",
    "fonscape": "node scripts/fonscape-update.ts",
    "check": "pnpm generate && pnpm test:offline && pnpm typecheck && pnpm lint && vite build && pnpm check:performance-budget"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@meting/core": "1.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/functions": "3.10.1",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.17",
    "katex": "^0.19.0",
    "mermaid": "^11.17.2",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "6.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
